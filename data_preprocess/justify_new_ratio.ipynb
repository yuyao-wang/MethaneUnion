   "source": [
    "#!/usr/bin/env python\n",
    "import argparse\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "\n",
    "def calibrate_gamma_c(m, p, y_med=0.4, y_hi=0.9):\n",
    "    \"\"\"\n",
    "    设定：D_M = m 时 sigmoid 输出 y_med，D_M = p 时输出 y_hi，\n",
    "    解出 gamma, c，使得：\n",
    "        sigma(gamma * m + c)  = y_med\n",
    "        sigma(gamma * p + c)  = y_hi\n",
    "    \"\"\"\n",
    "    # 防止 m == p\n",
    "    if not np.isfinite(m) or not np.isfinite(p) or abs(p - m) < 1e-6:\n",
    "        raise ValueError(f\"Invalid m/p for calibration: m={m}, p={p}\")\n",
    "\n",
    "    z_med = np.log(y_med / (1.0 - y_med))\n",
    "    z_hi = np.log(y_hi / (1.0 - y_hi))\n",
    "\n",
    "    gamma = (z_hi - z_med) / (p - m)\n",
    "    c = z_med - gamma * m\n",
    "    return float(gamma), float(c)\n",
    "\n",
    "\n",
    "def summarize_and_calibrate(dm_values, sensor_name, y_med=0.4, y_hi=0.9):\n",
    "    \"\"\"过滤 NaN/负值，打印统计，再做一次标定。\"\"\"\n",
    "    dm = np.asarray(dm_values, dtype=float)\n",
    "    mask = np.isfinite(dm) & (dm > 0)\n",
    "    dm = dm[mask]\n",
    "\n",
    "    if dm.size < 10:\n",
    "        raise ValueError(f\"{sensor_name}: too few valid DM_s values ({dm.size})\")\n",
    "\n",
    "    m = np.median(dm)\n",
    "    p = np.percentile(dm, 95)\n",
    "\n",
    "    print(f\"\\n=== {sensor_name} DM stats ===\")\n",
    "    print(f\"count         : {dm.size}\")\n",
    "    print(f\"median        : {m:.6f}\")\n",
    "    print(f\"95th percentile: {p:.6f}\")\n",
    "\n",
    "    gamma, c = calibrate_gamma_c(m, p, y_med=y_med, y_hi=y_hi)\n",
    "    print(f\"\\nCalibrated parameters for {sensor_name}:\")\n",
    "    print(f\"  gamma_{sensor_name} = {gamma:.6f}\")\n",
    "    print(f\"  c_{sensor_name}     = {c:.6f}\")\n",
    "\n",
    "    return gamma, c\n",
    "\n",
    "\n",
    "def main():\n",
    "    csv_path = Path(\"../carbon_mapper_data/csvs/merged_meqr_dm_stats.csv\")\n",
    "\n",
    "    df = pd.read_csv(csv_path)\n",
    "    if args.dm_s2_col not in df.columns or args.dm_l8_col not in df.columns:\n",
    "        raise KeyError(\n",
    "            f\"CSV must contain columns '{args.dm_s2_col}' and '{args.dm_l8_col}'. \"\n",
    "            f\"Found: {list(df.columns)}\"\n",
    "        )\n",
    "\n",
    "    gamma_s2, c_s2 = summarize_and_calibrate(\n",
    "        df[args.dm_s2_col], \"S2\", y_med=args.y_med, y_hi=args.y_hi\n",
    "    )\n",
    "    gamma_l8, c_l8 = summarize_and_calibrate(\n",
    "        df[args.dm_l8_col], \"L8\", y_med=args.y_med, y_hi=args.y_hi\n",
    "    )\n",
    "\n",
    "    print(\"\\n=== Paste these into your config/code ===\")\n",
    "    print(f\"GAMMA_S2 = {gamma_s2:.6f}\")\n",
    "    print(f\"C_S2     = {c_s2:.6f}\")\n",
    "    print(f\"GAMMA_L8 = {gamma_l8:.6f}\")\n",
    "    print(f\"C_L8     = {c_l8:.6f}\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()"
   ]
  },
