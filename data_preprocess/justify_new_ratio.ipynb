   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from pathlib import Path\n",
    "import tifffile\n",
    "import rasterio\n",
    "from rasterio.warp import reproject, Resampling\n",
    "\n",
    "CSV_PATH = Path(\"../carbon_mapper_data/csvs/merged_file_with_s2_l8_filtered_with_flags_low_cloud_only.csv\")\n",
    "MASK_BASE = Path(\"/data2/yuyao/methane_emission/carbon_mapper_data_masks\")\n",
    "S2_CHIP_BASE = Path(\"/data2/yuyao/methane_emission/carbonmapper_data_s2_l2a\")\n",
    "L8_CHIP_BASE = Path(\"/data2/yuyao/methane_emission/carbonmapper_data_l89_l2sp\")\n",
    "\n",
    "EPS = 1e-6\n",
    "\n",
    "def _ensure_cf(arr):\n",
    "    if arr.ndim == 2:\n",
    "        return arr[np.newaxis, ...]\n",
    "    if arr.ndim == 3 and arr.shape[0] <= 32:\n",
    "        return arr\n",
    "    if arr.ndim == 3 and arr.shape[-1] <= 32:\n",
    "        return np.moveaxis(arr, -1, 0)\n",
    "    raise ValueError(f\"unexpected array shape {arr.shape}\")\n",
    "\n",
    "def _read_image(path):\n",
    "    arr = tifffile.imread(path)\n",
    "    arr = _ensure_cf(arr)\n",
    "    profile = {\"height\": arr.shape[1], \"width\": arr.shape[2], \"transform\": None, \"crs\": None}\n",
    "    return arr, profile\n",
    "\n",
    "def _read_mask(path):\n",
    "    try:\n",
    "        with rasterio.open(path) as src:\n",
    "            arr = src.read(1)\n",
    "            profile = {\"height\": src.height, \"width\": src.width, \"transform\": src.transform, \"crs\": src.crs}\n",
    "            return arr, profile\n",
    "    except:\n",
    "        arr = tifffile.imread(path)\n",
    "        if arr.ndim == 3:\n",
    "            arr = arr[..., 0]\n",
    "        return arr, {\"height\": arr.shape[0], \"width\": arr.shape[1], \"transform\": None, \"crs\": None}\n",
    "\n",
    "def _resize_mask(mask, H, W):\n",
    "    if mask.shape == (H, W):\n",
    "        return mask\n",
    "    y = np.linspace(0, mask.shape[0]-1, H)\n",
    "    x = np.linspace(0, mask.shape[1]-1, W)\n",
    "    y = np.clip(np.round(y).astype(int), 0, mask.shape[0]-1)\n",
    "    x = np.clip(np.round(x).astype(int), 0, mask.shape[1]-1)\n",
    "    return mask[np.ix_(y, x)]\n",
    "\n",
    "def load_mask_like(mask_path, ref_profile):\n",
    "    mask, mp = _read_mask(mask_path)\n",
    "    if (mp[\"height\"], mp[\"width\"]) == (ref_profile[\"height\"], ref_profile[\"width\"]):\n",
    "        return mask\n",
    "    return _resize_mask(mask, ref_profile[\"height\"], ref_profile[\"width\"])\n",
    "\n",
    "def compute_DM(image_path, mask_path, methane_bands):\n",
    "    if image_path is None or not Path(image_path).exists():\n",
    "        return np.nan\n",
    "\n",
    "    img, prof = _read_image(image_path)\n",
    "    mask = load_mask_like(mask_path, prof)\n",
    "\n",
    "    HG, WG = prof[\"height\"], prof[\"width\"]\n",
    "    plume = mask > 0\n",
    "    bg = mask == 0\n",
    "\n",
    "    if plume.sum() < 10 or bg.sum() < 10:\n",
    "        return np.nan\n",
    "\n",
    "    DM_list = []\n",
    "    for b in methane_bands:\n",
    "        if b-1 >= img.shape[0]:\n",
    "            continue\n",
    "        band = img[b-1]\n",
    "        mu_p = band[plume].mean()\n",
    "        mu_b = band[bg].mean()\n",
    "        std_b = band[bg].std()\n",
    "        DM_list.append(abs(mu_p - mu_b) / (std_b + EPS))\n",
    "\n",
    "    return np.nanmax(DM_list) if DM_list else np.nan\n",
    "\n",
    "\n",
    "def resolve_s2(plume_id, dt):\n",
    "    folder = S2_CHIP_BASE / str(plume_id)\n",
    "    if not folder.exists():\n",
    "        return None\n",
    "    for tif in folder.glob(\"s2_*.tif\"):\n",
    "        return tif\n",
    "    return None\n",
    "\n",
    "def resolve_l8(plume_id):\n",
    "    folder = L8_CHIP_BASE / str(plume_id)\n",
    "    if not folder.exists():\n",
    "        return None\n",
    "    # just pick any one first\n",
    "    for tif in folder.glob(\"*.tif\"):\n",
    "        return tif\n",
    "    return None\n",
    "\n",
    "def main():\n",
    "    df = pd.read_csv(CSV_PATH)\n",
    "    df[\"plume_id\"] = df[\"plume_id\"].astype(str)\n",
    "\n",
    "    out_rows = []\n",
    "    for _, row in df.iterrows():\n",
    "        plume_id = row[\"plume_id\"]\n",
    "        mask_path = MASK_BASE / plume_id / \"plume.tif\"\n",
    "\n",
    "        s2_path = resolve_s2(plume_id, None)\n",
    "        l8_path = resolve_l8(plume_id)\n",
    "\n",
    "        DM_s2 = compute_DM(s2_path, mask_path, methane_bands=[11,12]) if s2_path else np.nan\n",
    "        DM_l8 = compute_DM(l8_path, mask_path, methane_bands=[6,7]) if l8_path else np.nan\n",
    "\n",
    "        out_rows.append({\n",
    "            \"plume_id\": plume_id,\n",
    "            \"DM_s2_max\": DM_s2,\n",
    "            \"DM_l8_max\": DM_l8\n",
    "        })\n",
    "\n",
    "    out_df = pd.DataFrame(out_rows)\n",
    "    out_df.to_csv(\"merged_meqr_dm_stats.csv\", index=False)\n",
    "    print(\"Saved merged_meqr_dm_stats.csv\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    main()\n"
   ]
